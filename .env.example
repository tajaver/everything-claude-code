# GEAR / TONIDOBOT Dashboard Configuration
# Copy this file to .env and fill in your values.

# Base URL for your LLM endpoint (Ollama, OpenAI-compatible proxy, etc.)
BASE_URL=http://localhost:11434

# API key (leave empty for Ollama which doesn't require auth)
API_KEY=

# Model name (optional — defaults to 'default')
MODEL=
